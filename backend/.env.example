# ============================
# 後端環境變數設定範本
# 使用方式：複製此檔案為 .env 並修改對應欄位
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
# ============================

# 後端 API 伺服器埠號
PORT=3000

# MySQL 資料庫連線設定
DB_HOST=127.0.0.1
DB_PORT=3306
